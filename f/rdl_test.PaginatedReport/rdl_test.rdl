  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="Allvisualtypesv3">
      <ConnectionProperties>
        <DataProvider>PBIDATASET</DataProvider>
        <ConnectString>Data Source=pbiazure://dailyapi.powerbi.com/;Identity Provider="https://login.microsoftonline.com/common, https://analysis.windows.net/powerbi/api, f0b72488-7082-488a-a7e8-eada97bd842d";Initial Catalog=sobe_wowvirtualserver-653fb385-9ca7-4e85-8e7a-fc21050fc9a4;Integrated Security=ClaimsToken</ConnectString>
      </ConnectionProperties>
      <rd:SecurityType>None</rd:SecurityType>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Allvisualtypesv3</DataSourceName>
        <CommandText>DEFINE VAR __DS0Core = 
	SUMMARIZECOLUMNS(
		ROLLUPADDISSUBTOTAL(
			ROLLUPGROUP(
				'DimProduct'[ProductKey],
				'DimProduct'[ProductAlternateKey],
				'DimProduct'[WeightUnitMeasureCode],
				'DimProduct'[SizeUnitMeasureCode],
				'DimProduct'[EnglishProductName],
				'DimProduct'[SpanishProductName],
				'DimProduct'[FrenchProductName],
				'DimProduct'[FinishedGoodsFlag],
				'DimProduct'[Color],
				'DimProduct'[Size],
				'DimProduct'[SizeRange],
				'DimProduct'[ProductLine],
				'DimProduct'[Class],
				'DimProduct'[Style],
				'DimProduct'[ModelName],
				'DimProduct'[EnglishDescription],
				'DimProduct'[FrenchDescription],
				'DimProduct'[ChineseDescription],
				'DimProduct'[ArabicDescription],
				'DimProduct'[HebrewDescription],
				'DimProduct'[ThaiDescription],
				'DimProduct'[GermanDescription],
				'DimProduct'[JapaneseDescription],
				'DimProduct'[TurkishDescription],
				'DimProduct'[StartDate],
				'DimProduct'[EndDate],
				'DimProduct'[Status]
			), "IsGrandTotalRowTotal"
		),
		"CountProductSubcategoryKey", CALCULATE(COUNTA('DimProduct'[ProductSubcategoryKey])),
		"SumStandardCost", CALCULATE(SUM('DimProduct'[StandardCost])),
		"SumSafetyStockLevel", CALCULATE(SUM('DimProduct'[SafetyStockLevel])),
		"SumReorderPoint", CALCULATE(SUM('DimProduct'[ReorderPoint])),
		"SumListPrice", CALCULATE(SUM('DimProduct'[ListPrice])),
		"SumWeight", CALCULATE(SUM('DimProduct'[Weight])),
		"SumDaysToManufacture", CALCULATE(SUM('DimProduct'[DaysToManufacture])),
		"SumDealerPrice", CALCULATE(SUM('DimProduct'[DealerPrice]))
	)

EVALUATE
	__DS0Core

ORDER BY
	[IsGrandTotalRowTotal] DESC,
	'DimProduct'[ProductKey],
	'DimProduct'[ProductAlternateKey],
	'DimProduct'[WeightUnitMeasureCode],
	'DimProduct'[SizeUnitMeasureCode],
	'DimProduct'[EnglishProductName],
	'DimProduct'[SpanishProductName],
	'DimProduct'[FrenchProductName],
	'DimProduct'[FinishedGoodsFlag],
	'DimProduct'[Color],
	'DimProduct'[Size],
	'DimProduct'[SizeRange],
	'DimProduct'[ProductLine],
	'DimProduct'[Class],
	'DimProduct'[Style],
	'DimProduct'[ModelName],
	'DimProduct'[EnglishDescription],
	'DimProduct'[FrenchDescription],
	'DimProduct'[ChineseDescription],
	'DimProduct'[ArabicDescription],
	'DimProduct'[HebrewDescription],
	'DimProduct'[ThaiDescription],
	'DimProduct'[GermanDescription],
	'DimProduct'[JapaneseDescription],
	'DimProduct'[TurkishDescription],
	'DimProduct'[StartDate],
	'DimProduct'[EndDate],
	'DimProduct'[Status]</CommandText>
        <wa:PreviewCommandText>DEFINE
	VAR __DS0Core = 
		SUMMARIZECOLUMNS(
			ROLLUPADDISSUBTOTAL(
				ROLLUPGROUP(
					'DimProduct'[ProductKey],
					'DimProduct'[ProductAlternateKey],
					'DimProduct'[WeightUnitMeasureCode],
